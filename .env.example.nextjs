# Leave unset in production when the Python API is deployed in this project.
# For local `next dev`, point the browser at the local FastAPI process.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-only values used by the local FastAPI process.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/market_data
GEMINI_API_KEY=
AUTH_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
